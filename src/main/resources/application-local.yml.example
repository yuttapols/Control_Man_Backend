# คัดลอกไฟล์นี้เป็น application-local.yml แล้วใส่ค่าจริง
# application-local.yml ถูก git-ignore ไว้ ห้าม commit ค่าจริงเข้า repo
#
#   cp application-local.yml.example application-local.yml
#
# ใช้เฉพาะเครื่อง developer เท่านั้น DEV/UAT/PROD ต้อง inject ผ่าน environment variable

spring:
  datasource:
    url: jdbc:postgresql://localhost:5432/control_m
    username: postgres
    password: CHANGE_ME

app:
  environment: LOCAL
  jwt:
    issuer: https://control-m.local
    audience: control-m-portal
    access-token-ttl: 15m
    private-key: ${JWT_PRIVATE_KEY}
    public-key: ${JWT_PUBLIC_KEY}
  auth:
    refresh-token-ttl: 7d
    refresh-idle-timeout: 24h
  auth-web:
    cookie-domain:
    secure-cookie: false
    allowed-origins:
      - http://localhost:4200

logging:
  level:
    root: INFO
